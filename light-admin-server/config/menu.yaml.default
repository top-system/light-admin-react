# Base menus and action permissions for a new installation.
- name: 首页
  type: 1
  route_name: home
  route_path: /home
  component: home/index
  icon: HomeOutlined
  sort: 1
- name: 系统管理
  type: 2
  route_name: system
  route_path: /system
  icon: SettingOutlined
  redirect: /system/user
  sort: 90
  children:
    - name: 用户管理
      type: 1
      route_name: user
      route_path: /system/user
      component: system/user/index
      icon: UserOutlined
      sort: 1
      children:
        - name: sys:user:query
          type: 4
          perm: sys:user:query
          visible: 0
          sort: 1
        - name: sys:user:add
          type: 4
          perm: sys:user:add
          visible: 0
          sort: 2
        - name: sys:user:edit
          type: 4
          perm: sys:user:edit
          visible: 0
          sort: 3
        - name: sys:user:delete
          type: 4
          perm: sys:user:delete
          visible: 0
          sort: 4
        - name: sys:user:reset-password
          type: 4
          perm: sys:user:reset-password
          visible: 0
          sort: 5
    - name: 角色管理
